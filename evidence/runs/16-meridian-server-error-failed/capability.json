{
  "schemaVersion": "1.0.0",
  "id": "cap_meridian_member_balance",
  "name": "meridian.member.balance",
  "title": "Read a member's shares and balances",
  "version": "1.0.0",
  "description": "Signs on to Meridian Core, opens the member record by member number, and reads the member's name, e-mail, and primary share balance and status.",
  "approval": "approved",
  "target": {
    "surface": "legacy-web",
    "app": "meridian-core",
    "appVersion": "4.2.1",
    "tenant": null,
    "entryUrl": "https://web-sample.interface-hiring.com/signon",
