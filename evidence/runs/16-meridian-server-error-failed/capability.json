      "name": "memberNumber",
      "type": "string",
      "required": true,
      "description": "The six-digit member number to look up.",
      "pattern": "^[0-9]{6}$",
      "sensitivity": "pii",
      "example": "100234"
    }
  ],
  "outputs": [
    {
      "name": "memberName",
      "type": "string",
      "description": "The member's name as shown on the member record.",
