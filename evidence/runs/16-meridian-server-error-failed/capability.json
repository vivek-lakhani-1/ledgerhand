    {
      "name": "primaryShareStatus",
      "type": "string",
      "description": "Status of the first share listed on the member record, such as OPEN or HOLD.",
      "required": true,
      "sensitivity": "public",
      "source": {
        "kind": "text_of",
        "target": {
          "role": "cell",
          "nameMatch": "exact",
          "framePath": [],
          "scope": {
            "nth": 0
