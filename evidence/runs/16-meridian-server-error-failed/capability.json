        "kind": "text_of",
        "target": {
          "role": "cell",
          "nameMatch": "exact",
          "framePath": [],
          "strategies": [
            {
              "kind": "css",
              "selector": "td:text-is(\"Name:\") + td",
              "confidence": 0.9,
              "origin": "derived"
            }
          ],
          "description": "Value cell to the right of the Name: label"
        },
        "transform": "trim"
      }
    },
    {
