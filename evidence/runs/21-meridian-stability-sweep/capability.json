{
  "schemaVersion": "1.0.0",
  "id": "cap_meridian_member_balance",
  "name": "meridian.member.balance",
  "title": "Read a member's shares and balances",
  "version": "1.0.0",
  "description": "Signs on to Meridian Core, opens the member record by member number, and reads the member's name, e-mail, and primary share balance and status.",
  "approval": "approved",
  "target": {
    "surface": "legacy-web",
    "app": "meridian-core",
    "appVersion": "4.2.1",
    "tenant": null,
    "entryUrl": "https://web-sample.interface-hiring.com/signon",
    "viewport": {
      "width": 1280,
      "height": 900
    }
  },
  "inputs": [
    {
      "name": "memberNumber",
      "type": "string",
      "required": true,
      "description": "The six-digit member number to look up.",
      "pattern": "^[0-9]{6}$",
      "sensitivity": "pii",
      "example": "100234"
    },
    {
      "name": "branch",
      "type": "enum",
      "required": false,
      "description": "Branch to sign on at: MAIN-001 (Main Office), WEST-014 (Westside), EAST-022 (Eastgate). Defaults to MAIN-001.",
      "enumValues": [
        "MAIN-001",
        "WEST-014",
        "EAST-022"
      ],
      "sensitivity": "public",
      "example": "MAIN-001",
      "default": "MAIN-001"
    }
  ],
  "outputs": [
