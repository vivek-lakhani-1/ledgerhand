              {
                "kind": "attribute",
                "attr": "name",
                "value": "operator",
                "confidence": 0.98,
                "origin": "captured"
              }
            ],
            "description": "Operator ID field"
          },
          "value": "{{secrets.MERIDIAN_HOLD_OPERATOR}}",
          "clearFirst": true
        },
        {
          "type": "type",
          "target": {
            "role": "textbox",
            "framePath": [],
            "strategies": [
              {
                "kind": "attribute",
                "attr": "name",
                "value": "password",
                "confidence": 0.98,
                "origin": "captured"
              }
            ],
            "description": "Operator password field"
          },
