{
  "schemaVersion": "1.0.0",
  "id": "cap_meridian_account_hold",
  "name": "meridian.account.hold",
  "title": "Place a hold on a member share",
  "version": "1.0.0",
  "description": "Signs on to Meridian Core as the hold operator, fills the restricted Place Account Hold form, walks the review step, and applies the hold. Requires a supervisor profile; a non-supervisor attempt stops and escalates.",
  "approval": "approved",
  "target": {
    "surface": "legacy-web",
    "app": "meridian-core",
    "appVersion": "4.2.1",
    "tenant": null,
    "entryUrl": "https://web-sample.interface-hiring.com/signon",
    "viewport": {
      "width": 1280,
      "height": 900
    }
  },
  "inputs": [
    {
      "name": "memberNumber",
      "type": "string",
      "required": true,
      "description": "The six-digit member number whose share is being held.",
      "pattern": "^[0-9]{6}$",
      "sensitivity": "pii",
      "example": "100234"
    },
    {
      "name": "shareId",
      "type": "string",
      "required": true,
      "description": "Share ID to place on hold, for example 100234-S0001.",
      "sensitivity": "public",
      "example": "100234-S0001"
    },
    {
      "name": "reasonCode",
      "type": "enum",
      "required": true,
      "description": "Reason code for the hold.",
      "enumValues": [
        "FRAUD",
        "LEGAL",
        "DECEASED"
      ],
      "sensitivity": "public",
      "example": "FRAUD"
    },
    {
      "name": "notes",
      "type": "string",
      "required": true,
      "description": "Notes recorded with the hold. May be empty.",
      "sensitivity": "public",
      "example": "Verification review"
    }
  ],
  "outputs": [
    {
      "name": "confirmationNumber",
      "type": "string",
      "description": "Confirmation number of the applied hold.",
      "required": true,
      "sensitivity": "public",
      "source": {
        "kind": "text_of",
        "target": {
          "role": "cell",
          "framePath": [],
          "strategies": [
            {
              "kind": "css",
              "selector": "td:text-is(\"Confirmation:\") + td",
              "confidence": 0.9,
              "origin": "derived"
            }
          ],
          "description": "Value cell to the right of the Confirmation: label"
        },
        "transform": "trim"
      }
    }
  ],
  "secretsRequired": [
    "MERIDIAN_HOLD_OPERATOR",
    "MERIDIAN_HOLD_PASSWORD"
  ],
  "steps": [
    {
      "id": "s1",
      "description": "Enter the operator ID",
      "action": {
        "type": "type",
        "target": {
          "role": "textbox",
          "framePath": [],
          "strategies": [
            {
              "kind": "attribute",
              "attr": "name",
              "value": "operator",
              "confidence": 0.98,
              "origin": "captured"
            }
          ],
          "description": "Operator ID field"
        },
        "value": "{{secrets.MERIDIAN_HOLD_OPERATOR}}",
        "clearFirst": true
      },
      "postcondition": {
        "kind": "control_present",
        "target": {
          "role": "textbox",
          "framePath": [],
          "strategies": [
            {
              "kind": "attribute",
              "attr": "name",
              "value": "password",
              "confidence": 0.98,
              "origin": "captured"
            }
          ],
          "description": "Operator password field"
        }
      }
    },
    {
      "id": "s2",
      "description": "Enter the operator password",
      "action": {
        "type": "type",
        "target": {
          "role": "textbox",
          "framePath": [],
          "strategies": [
            {
              "kind": "attribute",
              "attr": "name",
              "value": "password",
              "confidence": 0.98,
              "origin": "captured"
            }
          ],
          "description": "Operator password field"
        },
        "value": "{{secrets.MERIDIAN_HOLD_PASSWORD}}",
        "clearFirst": true
      },
      "postcondition": {
        "kind": "control_present",
        "target": {
          "role": "button",
          "name": "Sign On",
          "framePath": [],
          "strategies": [
            {
              "kind": "aria",
              "role": "button",
              "name": "Sign On",
              "exact": true,
              "confidence": 0.99,
              "origin": "captured"
            }
          ],
          "description": "Sign On button"
        }
      }
    },
    {
      "id": "s3",
      "description": "Sign on to the console",
      "action": {
        "type": "click",
        "target": {
          "role": "button",
          "name": "Sign On",
          "framePath": [],
          "strategies": [
            {
              "kind": "aria",
              "role": "button",
              "name": "Sign On",
              "exact": true,
              "confidence": 0.99,
              "origin": "captured"
            }
          ],
          "description": "Sign On button"
        }
      },
      "retries": {
        "max": 1,
        "backoffMs": 500
      },
      "postcondition": {
        "kind": "text_present",
        "text": "MAIN MENU",
        "match": "contains",
        "framePath": []
      }
    },
    {
      "id": "s4",
      "description": "Open the member's Place Account Hold form",
      "action": {
        "type": "navigate",
        "url": "https://web-sample.interface-hiring.com/members/{{inputs.memberNumber}}/hold"
      },
      "retries": {
        "max": 1,
        "backoffMs": 500
      },
      "postcondition": {
        "kind": "text_present",
        "text": "PLACE ACCOUNT HOLD",
        "match": "contains",
        "framePath": [],
        "timeoutMs": 8000
      }
    },
    {
      "id": "s5",
      "description": "Choose the share to hold",
      "action": {
        "type": "select",
        "target": {
          "role": "combobox",
          "framePath": [],
          "strategies": [
            {
              "kind": "attribute",
              "attr": "name",
              "value": "share",
              "confidence": 0.98,
              "origin": "captured"
            }
          ],
          "description": "Share list"
        },
        "value": "{{inputs.shareId}}"
      }
    },
    {
      "id": "s6",
      "description": "Choose the hold reason code",
      "action": {
        "type": "select",
        "target": {
          "role": "combobox",
          "framePath": [],
          "strategies": [
            {
              "kind": "attribute",
              "attr": "name",
              "value": "reason",
              "confidence": 0.98,
              "origin": "captured"
            }
          ],
          "description": "Reason Code list"
        },
        "value": "{{inputs.reasonCode}}"
      }
    },
    {
      "id": "s7",
      "description": "Enter the hold notes",
      "action": {
        "type": "type",
        "target": {
          "role": "textbox",
          "framePath": [],
          "strategies": [
            {
              "kind": "attribute",
              "attr": "name",
              "value": "notes",
              "confidence": 0.98,
              "origin": "captured"
            }
          ],
          "description": "Notes field"
        },
        "value": "{{inputs.notes}}",
        "clearFirst": true
      }
    },
    {
      "id": "s8",
      "description": "Continue to the hold review screen",
      "action": {
        "type": "click",
        "target": {
          "role": "button",
          "name": "Continue",
          "framePath": [],
          "strategies": [
            {
              "kind": "aria",
              "role": "button",
              "name": "Continue",
              "exact": true,
              "confidence": 0.99,
              "origin": "captured"
            }
          ],
          "description": "Continue button"
        }
      },
      "onFailure": "escalate",
      "postcondition": {
        "kind": "text_present",
        "text": "CONFIRM ACCOUNT HOLD",
        "match": "contains",
        "framePath": [],
        "timeoutMs": 8000
      }
    },
    {
      "id": "s9",
      "description": "Apply the reviewed hold",
      "action": {
        "type": "click",
        "target": {
          "role": "button",
          "name": "Apply Hold",
          "framePath": [],
          "strategies": [
            {
              "kind": "aria",
              "role": "button",
              "name": "Apply Hold",
              "exact": true,
              "confidence": 0.99,
              "origin": "captured"
            }
          ],
          "description": "Apply Hold button"
        }
      },
      "risk": "irreversible",
      "onFailure": "escalate",
      "postcondition": {
        "kind": "text_present",
        "text": "HOLD RECORDED",
        "match": "contains",
        "framePath": [],
        "timeoutMs": 8000
      }
    }
  ],
  "outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "No member record exists for the requested member number.",
      "detect": {
        "kind": "all",
        "of": [
          {
            "kind": "text_present",
            "text": "RECORD NOT FOUND",
            "match": "contains",
            "framePath": []
          },
          {
            "kind": "url_matches",
            "pattern": "/members/"
          }
        ],
        "description": "RECORD NOT FOUND shown for a member-record request"
      },
      "terminal": true,
      "outputs": []
    },
    {
      "code": "TRANSACTION_REJECTED",
      "description": "The host rejected the transaction.",
      "detect": {
        "kind": "text_present",
        "text": "TRANSACTION REJECTED",
        "match": "contains",
        "framePath": []
      },
      "terminal": true,
      "outputs": []
    }
  ],
