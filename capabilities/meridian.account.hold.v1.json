        "text": "SCHEDULED MAINTENANCE IN PROGRESS",
        "match": "contains",
        "framePath": []
      },
      "do": [
        {
          "type": "click",
          "target": {
            "role": "link",
            "name": "Continue",
            "framePath": [],
            "strategies": [
              {
                "kind": "aria",
                "role": "link",
                "name": "Continue",
                "exact": true,
                "confidence": 0.99,
