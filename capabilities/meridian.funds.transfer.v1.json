    },
    {
      "id": "s9",
      "description": "Continue to the transfer review screen",
      "action": {
        "type": "click",
        "target": {
          "role": "button",
          "name": "Continue",
          "framePath": [],
          "strategies": [
            {
              "kind": "aria",
              "role": "button",
              "name": "Continue",
              "exact": true,
              "confidence": 0.99,
              "origin": "captured"
            }
          ],
          "description": "Continue button"
