    },
    {
      "id": "s8",
      "description": "Enter the transfer memo",
      "action": {
        "type": "type",
        "target": {
          "role": "textbox",
          "framePath": [],
          "strategies": [
            {
              "kind": "attribute",
              "attr": "name",
              "value": "memo",
              "confidence": 0.98,
              "origin": "captured"
            }
          ],
          "description": "Memo field"
        },
