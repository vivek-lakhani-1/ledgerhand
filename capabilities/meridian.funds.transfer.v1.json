{
  "schemaVersion": "1.0.0",
  "id": "cap_meridian_funds_transfer",
  "name": "meridian.funds.transfer",
  "title": "Transfer funds between a member's shares",
  "version": "1.0.0",
  "description": "Signs on to Meridian Core, fills the member's Funds Transfer form, walks the review step, and posts the transfer. Posting is irreversible.",
  "approval": "approved",
  "target": {
    "surface": "legacy-web",
    "app": "meridian-core",
    "appVersion": "4.2.1",
    "tenant": null,
    "entryUrl": "https://web-sample.interface-hiring.com/signon",
    "viewport": {
      "width": 1280,
      "height": 900
    }
  },
  "inputs": [
    {
      "name": "memberNumber",
      "type": "string",
      "required": true,
      "description": "The six-digit member number whose shares are involved.",
      "pattern": "^[0-9]{6}$",
      "sensitivity": "pii",
      "example": "100234"
    },
    {
      "name": "fromShareId",
      "type": "string",
      "required": true,
      "description": "Share ID to draw funds from, for example 100234-S0001.",
      "sensitivity": "public",
      "example": "100234-S0001"
    },
    {
      "name": "toShareId",
      "type": "string",
      "required": true,
      "description": "Share ID to deposit funds into.",
      "sensitivity": "public",
      "example": "100234-S0070"
    },
    {
      "name": "amount",
      "type": "string",
      "required": true,
      "description": "Dollar amount to transfer, for example 25.00.",
      "pattern": "^[0-9]+(\\.[0-9]{1,2})?$",
      "sensitivity": "public",
      "example": "25.00"
    },
    {
      "name": "memo",
      "type": "string",
      "required": true,
      "description": "Short memo recorded with the transfer. May be empty.",
      "sensitivity": "public",
      "example": "Phone request"
    }
  ],
  "outputs": [
    {
      "name": "confirmationNumber",
      "type": "string",
      "description": "Confirmation number of the posted transfer.",
      "required": true,
      "sensitivity": "public",
      "source": {
        "kind": "text_of",
        "target": {
          "role": "cell",
          "framePath": [],
          "strategies": [
            {
              "kind": "css",
              "selector": "td:text-is(\"Confirmation:\") + td",
              "confidence": 0.9,
              "origin": "derived"
            }
          ],
          "description": "Value cell to the right of the Confirmation: label"
        },
        "transform": "trim"
      }
    },
    {
      "name": "postedAt",
      "type": "string",
      "description": "Timestamp the transfer posted.",
      "required": true,
      "sensitivity": "public",
      "source": {
        "kind": "text_of",
        "target": {
          "role": "cell",
          "framePath": [],
          "strategies": [
            {
              "kind": "css",
              "selector": "td:text-is(\"Posted:\") + td",
              "confidence": 0.9,
              "origin": "derived"
            }
          ],
          "description": "Value cell to the right of the Posted: label"
        },
        "transform": "trim"
      }
    }
  ],
  "secretsRequired": [
    "MERIDIAN_OPERATOR",
    "MERIDIAN_PASSWORD"
  ],
  "steps": [
