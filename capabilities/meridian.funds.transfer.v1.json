      },
      "retries": {
        "max": 1,
        "backoffMs": 500
      },
      "postcondition": {
        "kind": "text_present",
        "text": "CONFIRM FUNDS TRANSFER",
        "match": "contains",
        "framePath": [],
        "timeoutMs": 8000
      }
    },
    {
      "id": "s10",
      "description": "Post the reviewed transfer",
      "action": {
        "type": "click",
        "target": {
          "role": "button",
          "name": "Post Transfer",
          "framePath": [],
          "strategies": [
            {
              "kind": "aria",
              "role": "button",
              "name": "Post Transfer",
              "exact": true,
              "confidence": 0.99,
              "origin": "captured"
            }
          ],
          "description": "Post Transfer button"
        }
      },
      "risk": "irreversible",
      "onFailure": "escalate",
      "postcondition": {
        "kind": "text_present",
        "text": "TRANSACTION COMPLETE",
        "match": "contains",
        "framePath": [],
        "timeoutMs": 8000
      }
    }
  ],
  "outcomes": [
    {
      "code": "INSUFFICIENT_FUNDS",
