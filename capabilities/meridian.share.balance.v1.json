{
  "schemaVersion": "1.0.0",
  "id": "cap_meridian_share_balance",
  "name": "meridian.share.balance",
  "title": "Read one share's balance by share ID",
  "version": "1.0.0",
  "description": "Signs on to Meridian Core, opens the member record, and reads the type, balance and status of the specific share row matching the supplied share ID.",
  "approval": "approved",
  "target": {
    "surface": "legacy-web",
    "app": "meridian-core",
    "appVersion": "4.2.1",
    "tenant": null,
    "entryUrl": "https://web-sample.interface-hiring.com/signon",
    "viewport": {
      "width": 1280,
      "height": 900
    }
  },
  "inputs": [
    {
      "name": "memberNumber",
      "type": "string",
      "required": true,
      "description": "The six-digit member number to look up.",
      "pattern": "^[0-9]{6}$",
      "sensitivity": "pii",
      "example": "100234"
    },
    {
      "name": "shareId",
      "type": "string",
      "required": true,
      "description": "The exact share ID whose row to read, e.g. 100234-S0070.",
      "pattern": "^[0-9]{6}-[A-Za-z0-9-]+$",
      "sensitivity": "public",
      "example": "100234-S0070"
    },
    {
      "name": "branch",
      "type": "enum",
      "required": false,
      "enumValues": [
        "MAIN-001",
        "WEST-014",
        "EAST-022"
      ],
      "description": "Branch to sign on at: MAIN-001 (Main Office), WEST-014 (Westside), EAST-022 (Eastgate). Defaults to MAIN-001.",
      "sensitivity": "public",
      "example": "MAIN-001",
      "default": "MAIN-001"
    }
  ],
  "outputs": [
    {
      "name": "memberName",
      "type": "string",
      "description": "The member's name as shown on the member record.",
      "required": true,
      "sensitivity": "pii",
      "source": {
        "kind": "text_of",
        "target": {
          "role": "cell",
          "framePath": [],
          "strategies": [
            {
              "kind": "css",
              "selector": "td:text-is(\"Name:\") + td",
              "confidence": 0.9,
              "origin": "derived"
            }
          ],
          "description": "Value cell to the right of the Name: label"
        },
        "transform": "trim"
      }
    },
    {
      "name": "shareType",
      "type": "string",
      "description": "Type of the requested share, e.g. Regular Shares.",
      "required": true,
      "sensitivity": "public",
      "source": {
        "kind": "text_of",
        "target": {
          "role": "cell",
          "framePath": [],
          "strategies": [
            {
              "kind": "table_cell",
              "rowMatch": "{{inputs.shareId}}",
              "columnHeader": "Type",
              "confidence": 0.85,
              "origin": "derived"
            }
          ],
          "description": "Type cell of the row whose Share ID matches the supplied share id"
        },
        "transform": "trim"
      }
    },
    {
      "name": "shareBalance",
      "type": "currency",
      "description": "Current balance of the requested share.",
      "required": true,
      "sensitivity": "public",
      "source": {
        "kind": "text_of",
        "target": {
          "role": "cell",
          "framePath": [],
          "strategies": [
            {
              "kind": "table_cell",
              "rowMatch": "{{inputs.shareId}}",
              "columnHeader": "Balance",
              "confidence": 0.85,
              "origin": "derived"
            }
          ],
          "description": "Balance cell of the row whose Share ID matches the supplied share id"
        },
        "transform": "currency_to_number"
      }
    },
    {
      "name": "shareStatus",
      "type": "string",
      "description": "Status of the requested share, such as OPEN or HOLD.",
      "required": true,
      "sensitivity": "public",
      "source": {
        "kind": "text_of",
        "target": {
          "role": "cell",
          "framePath": [],
          "strategies": [
            {
              "kind": "table_cell",
              "rowMatch": "{{inputs.shareId}}",
              "columnHeader": "Status",
              "confidence": 0.85,
              "origin": "derived"
            }
          ],
          "description": "Status cell of the row whose Share ID matches the supplied share id"
        },
        "transform": "trim"
      }
    }
  ],
