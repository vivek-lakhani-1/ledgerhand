  "steps": [
    {
      "id": "s1",
      "description": "Enter the operator ID",
      "action": {
        "type": "type",
        "target": {
          "role": "textbox",
          "framePath": [],
          "strategies": [
            {
              "kind": "attribute",
              "attr": "name",
              "value": "operator",
              "confidence": 0.98,
              "origin": "captured"
            }
          ],
          "description": "Operator ID field"
        },
        "value": "{{secrets.MERIDIAN_OPERATOR}}",
        "clearFirst": true
      },
      "postcondition": {
        "kind": "control_present",
        "target": {
          "role": "textbox",
          "framePath": [],
          "strategies": [
            {
              "kind": "attribute",
              "attr": "name",
              "value": "password",
              "confidence": 0.98,
              "origin": "captured"
            }
          ],
          "description": "Operator password field"
        }
      }
    },
    {
      "id": "s2",
      "description": "Enter the operator password",
      "action": {
        "type": "type",
        "target": {
          "role": "textbox",
          "framePath": [],
          "strategies": [
            {
              "kind": "attribute",
              "attr": "name",
              "value": "password",
              "confidence": 0.98,
              "origin": "captured"
            }
          ],
          "description": "Operator password field"
        },
        "value": "{{secrets.MERIDIAN_PASSWORD}}",
        "clearFirst": true
      },
      "postcondition": {
        "kind": "control_present",
        "target": {
          "role": "button",
          "name": "Sign On",
          "framePath": [],
          "strategies": [
            {
              "kind": "aria",
              "role": "button",
              "name": "Sign On",
              "exact": true,
              "confidence": 0.99,
              "origin": "captured"
            }
          ],
          "description": "Sign On button"
        }
      }
    },
    {
      "id": "s3",
      "description": "Sign on to the console",
      "action": {
        "type": "click",
        "target": {
          "role": "button",
          "name": "Sign On",
          "framePath": [],
          "strategies": [
            {
              "kind": "aria",
              "role": "button",
              "name": "Sign On",
              "exact": true,
              "confidence": 0.99,
              "origin": "captured"
            }
          ],
          "description": "Sign On button"
        }
      },
      "retries": {
        "max": 1,
        "backoffMs": 500
      },
      "postcondition": {
        "kind": "text_present",
        "text": "MAIN MENU",
        "match": "contains",
        "framePath": []
      }
    },
    {
      "id": "s4",
      "description": "Read the session status line",
      "action": {
        "type": "extract",
        "outputs": [
          "sessionStatus"
        ]
      }
