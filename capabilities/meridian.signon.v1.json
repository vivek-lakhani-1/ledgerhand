      "sensitivity": "public",
      "source": {
        "kind": "text_of",
        "target": {
          "role": "cell",
          "framePath": [],
          "strategies": [
            {
              "kind": "css",
              "selector": "td[bgcolor=\"#e4e4e4\"]",
              "confidence": 0.85,
              "origin": "derived"
